<%- include('../partials/header') %>

<div class="page-header">
  <h1>Modifica genere</h1>
</div>

<form action="/genres/<%= genre.id %>/update" method="POST" class="form">
  <div class="form-group">
    <label for="name">Nome</label>
    <input type="text" id="name" name="name" value="<%= genre.name %>" required>
  </div>
  <div class="form-group">
    <label for="description">Descrizione</label>
    <textarea id="description" name="description" rows="4"><%= genre.description || '' %></textarea>
  </div>
  <div class="form-actions">
    <a href="/genres" class="btn btn-secondary">Annulla</a>
    <button type="submit" class="btn">Salva modifiche</button>
  </div>
</form>

<%- include('../partials/footer') %>