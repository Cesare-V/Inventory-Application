<%- include('../partials/header') %>

<div class="page-header">
  <h1>Generi</h1>
  <a href="/genres/new" class="btn">+ Nuovo genere</a>
</div>

<div class="grid">
  <% genres.forEach(genre => { %>
    <a href="/genres/<%= genre.id %>" class="card">
      <h2><%= genre.name %></h2>
      <p><%= genre.description || 'Nessuna descrizione' %></p>
    </a>
  <% }) %>
</div>

<%- include('../partials/footer') %>