<%- include('../partials/header') %>

<div class="page-header">
  <h1>Giochi</h1>
  <a href="/games/new" class="btn">+ Nuovo gioco</a>
</div>

<div class="grid">
  <% games.forEach(game => { %>
    <a href="/games/<%= game.id %>" class="card">
      <% if (game.image_url) { %>
        <img src="<%= game.image_url %>" alt="<%= game.title %>">
      <% } %>
      <div class="card-body">
        <h2><%= game.title %></h2>
        <span class="badge"><%= game.genre_name %></span>
        <p class="price">€ <%= game.price %></p>
        <p class="stock"><%= game.stock %> disponibili</p>
      </div>
    </a>
  <% }) %>
</div>

<%- include('../partials/footer') %>