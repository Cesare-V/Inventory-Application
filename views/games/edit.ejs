<%- include('../partials/header') %>

<div class="page-header">
  <h1>Modifica gioco</h1>
</div>

<form action="/games/<%= game.id %>/update" method="POST" class="form">
  <div class="form-group">
    <label for="title">Titolo</label>
    <input type="text" id="title" name="title" value="<%= game.title %>" required>
  </div>
  <div class="form-group">
    <label for="description">Descrizione</label>
    <textarea id="description" name="description" rows="4"><%= game.description || '' %></textarea>
  </div>
  <div class="form-group">
    <label for="genre_id">Genere</label>
    <select id="genre_id" name="genre_id" required>
      <% genres.forEach(genre => { %>
        <option value="<%= genre.id %>" <%= genre.id === game.genre_id ? 'selected' : '' %>>
          <%= genre.name %>
        </option>
      <% }) %>
    </select>
  </div>
  <div class="form-group">
    <label for="price">Prezzo (€)</label>
    <input type="number" id="price" name="price" step="0.01" value="<%= game.price %>" required>
  </div>
  <div class="form-group">
    <label for="stock">Quantità in stock</label>
    <input type="number" id="stock" name="stock" value="<%= game.stock %>" required>
  </div>
  <div class="form-group">
    <label for="image_url">URL immagine</label>
    <input type="url" id="image_url" name="image_url" value="<%= game.image_url || '' %>">
  </div>
  <div class="form-actions">
    <a href="/games" class="btn btn-secondary">Annulla</a>
    <button type="submit" class="btn">Salva modifiche</button>
  </div>
</form>

<%- include('../partials/footer') %>